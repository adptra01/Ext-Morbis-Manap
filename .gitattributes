* text=auto eol=lf

# TypeScript / JavaScript
*.ts text eol=lf
*.mjs text eol=lf
*.js text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.svg text eol=lf

# Config
*.yml text eol=lf
*.yaml text eol=lf

# Shell/scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Diffs
*.blade.php diff=html
*.md diff=markdown
*.json diff=json

# Export-ignore (not included in release archives)
CHANGELOG.md export-ignore
README.md export-ignore
.github/ export-ignore
tests/ export-ignore
scripts/ export-ignore
mcp-servers/ export-ignore

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.crx binary
*.xpi binary
*.pem binary
*.pyc binary
