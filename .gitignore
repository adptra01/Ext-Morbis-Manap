# Dependencies
node_modules/

# Build output
# dist/
# Sourcemap hanya hasil build non-produksi. Kalau ikut ter-commit, ikut
# ter-zip ke dalam CRX (pack.mjs zip semua isi dist/) = membengkak +
# kode sumber ikut tersebar ke artifact yang dibagikan.
dist/**/*.map
*.crx
*.xpi
*.zip
*.pem
deploy/update.xml

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor / config
.claude/
.opencode/
opencode.json

# Test artifacts
test-results/
coverage/
debug-*.png
*.screenshot.png

# Project-specific
example_code/
code_views/
screenshots/
.playwright-mcp/
tool/
tests/
pages/

# Environment files
.env
.env.local
.env.*.local
.env

