# Dependencies
node_modules/

# Build output
# dist/ SENGAJA tracked (konvensi proyek: CI & enterprise CRX memakai isi
# repo; jangan di-ignore). Yang TIDAK ikut: sourcemap (membengkak + kode
# sumber tersebar ke artifact), paket,& private key.
# dist/**/*.map
# *.crx
# *.xpi
# *.zip
# *.pem
# deploy/update.xml

# Dokumentasi desain internal (rujukan lokal developer, tidak dikirim repo).
# examples/ & *.md yang dipakai user (Pages) tetap tracked.
docs/sirs/
docs/evidence/*

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor / config
.claude/
.opencode/
opencode.json

# Test artifacts (test suite-nya sendiri — tests/unit, tests/e2e — tetap
# tracked; yang di-ignore hanya artefak & scratch one-off)
test-results/
playwright-report/
coverage/
screenshots/
pages/
.playwright-mcp/
debug-*.png
*.screenshot.png
# Scratch di tests/: screenshot & one-off debug/login
tests/**/*.png
tests/**/debug-*.cjs
tests/**/debug-*.mjs
# Junk root yang pernah ter-track
backup-*.png
/--no-sandbox

# Project-specific
example_code/
code_views/
tts_cache/*

# Environment files
.env
.env.local
.env.*.local

# Python (dev/ tools: tts_service.py, mcp-servers)
venv/
__pycache__/
*.py[cod]

# agent-browser local browser profile (state/data)
.agent-browser-profile/
.agent-notes/
