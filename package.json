{
  "name": "morbis-ext-unofficial",
  "version": "1.2.1",
  "description": "Ekstensi produktivitas untuk SIMRS MORBIS Klaim",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "build:prod": "vite build && node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "dev": "vite build --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,html,css}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "pack": "npm run build && node scripts/pack.mjs",
    "deploy": "npm run pack && node scripts/deploy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --ui --config=tests/e2e/playwright.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-switch": "^1.3.1",
    "@types/chrome": "^0.0.270",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.15.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "lucide-react": "^1.18.0",
    "postcss": "^8.5.15",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
