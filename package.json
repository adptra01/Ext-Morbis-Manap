{
  "name": "morbis-ext-unofficial",
  "version": "1.5.145",
  "description": "Ekstensi produktivitas untuk SIMRS MORBIS Klaim",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "build:prod": "vite build && node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "dev": "vite build --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,html,css}\"",
    "changelog": "node scripts/changelog.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "audit": "node scripts/audit-features.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "deploy": "npm run pack && node scripts/deploy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --ui --config=tests/e2e/playwright.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-switch": "^1.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.0.270",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.49.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rimraf": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
