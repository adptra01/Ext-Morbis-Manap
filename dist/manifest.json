{
  "manifest_version": 3,
  "name": "MORBIS Ext Unofficial",
  "version": "1.2.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "morbis-ext@rsud-manap.com",
      "update_url": "https://adptra01.github.io/Ext-Morbis-Manap/updates.json"
    }
  },
  "update_url": "https://adptra01.github.io/Ext-Morbis-Manap/update.xml",
  "description": "Ekstensi produktivitas untuk SIMRS MORBIS Klaim - buka detail di tab baru, batch upload, dan fitur lainnya",
  "author": "Your Name",
  "icons": {
    "16": "icons/bluemorbis16.png",
    "32": "icons/bluemorbis32.png",
    "48": "icons/bluemorbis48.png",
    "128": "icons/bluemorbis128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "MORBIS Ext Unofficial"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/v2/m-klaim*",
        "http://*/billing/pembayaran-new/billing-verifikasi*",
        "http://*/inventory/penjualan-bebas*"
      ],
      "js": [
        "core.js",
        "features/shared/cookieFilterStorage.js",
        "features/openDetail.js",
        "features/toolbar.js",
        "features/filterPersistence.js",
        "features/scrollButtons.js",
        "features/batchUploadUrl.js",
        "features/batchDeleteFiles.js",
        "init.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/billing/pembayaran-new/billing-verifikasi*"
      ],
      "js": [
        "core.js",
        "features/shared/cookieFilterStorage.js",
        "features/billingFilterPersistence.js",
        "init.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/inventory/penjualan-resep-edit/*"
      ],
      "js": [
        "core.js",
        "features/penerimaan_resep/main.js",
        "init.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/admisi/pelaksanaan-operasi*",
        "http://*/admisi/pelaksanaan_pelayanan*",
        "http://*/admisi/detail-rawat-inap*",
        "http://*/rekam-medik/rm-rawat-jalan-new*"
      ],
      "js": [
        "core.js",
        "features/shared/cookieFilterStorage.js",
        "features/doctorFilterPersistence.js",
        "features/cpptSearchFilter.js",
        "init.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/admisi/pelaksanaan_pelayanan/edit-operasi*",
        "http://*/admisi/detail-rawat-inap/edit-operasi*"
      ],
      "js": [
        "features/pindahOperasi/main.js"
      ],
      "run_at": "document_end",
      "all_frames": false
